# Copy to .env and fill in the provider(s) you want to use.
# On Streamlit Community Cloud, add the same keys under App settings > Secrets.

# Hugging Face Inference Providers (https://huggingface.co/settings/tokens)
HF_TOKEN=
# HF_MODEL=openai/gpt-oss-120b

# Anthropic Claude
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium

# Ollama (local)
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3.5:4b
# Context window. Pick a model that fits your GPU: one that spills into system RAM
# (e.g. gpt-oss:20b on a 6 GB GPU) can crash intermittently while loading.
# OLLAMA_NUM_CTX=8192

# Retrieval
# RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# RAG_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# auto = NVIDIA GPU when onnxruntime-gpu is installed (see README), else CPU; cpu forces the CPU
# RAG_EMBEDDING_DEVICE=auto
# RAG_PERSIST_DIR=chroma_db
# chroma (no server) or qdrant (shared by the API and the index worker, see docker-compose.dev.yml)
# RAG_VECTOR_STORE=chroma
# QDRANT_URL=http://127.0.0.1:6333
# Send index jobs to the worker (python -m api.worker); needs RAG_VECTOR_STORE=qdrant
# REDIS_URL=redis://127.0.0.1:6379
# Restrict the "Folder Path" input to one directory tree (recommended on public deployments)
# RAG_ALLOWED_ROOT=/mount/src/codebase-rag-assistant
